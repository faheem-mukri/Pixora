# Server Configuration
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/pixora

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# APIs
PEXELS_API_KEY=your_pexels_api_key_here

# Cloudinary (optional - for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL (for CORS)
# Single origin, or a comma-separated list via FRONTEND_URLS for multiple
# (e.g. custom domain + www + preview deployments).
FRONTEND_URL=http://localhost:3000
# FRONTEND_URLS=https://app.example.com,https://www.example.com

# Node Environment
NODE_ENV=development

# ----- Cookie / cross-site auth configuration -----
# Set COOKIE_CROSS_SITE=true when the frontend and backend are served from
# DIFFERENT sites (e.g. Vercel frontend + Render backend). This sends cookies
# with SameSite=None; Secure. NOTE: third-party cookies are blocked by Safari,
# most mobile browsers, and incognito mode even with this set.
#
# For reliable cross-browser auth, serve both behind a shared parent domain
# (app.example.com + api.example.com), leave COOKIE_CROSS_SITE unset (SameSite=Lax),
# and set COOKIE_DOMAIN so the cookie is shared first-party across subdomains.
COOKIE_CROSS_SITE=false
# COOKIE_DOMAIN=.example.com

# ============================================
# PRODUCTION (Vercel + Render Deployment)
# ============================================

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pixora?retryWrites=true&w=majority
FRONTEND_URL=https://yourusername.vercel.app
NODE_ENV=production
# Cross-site fallback (works on Chrome/Edge, blocked on Safari/mobile/incognito):
COOKIE_CROSS_SITE=true
# Recommended first-party setup instead (shared parent domain):
# COOKIE_CROSS_SITE=false
# COOKIE_DOMAIN=.example.com
